// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(uuid())
  phoneNumber        String        @unique
  name               String
  birthDay           DateTime
  password           String
  role               UserRole      @default(ORDINARY)
  hashedRefreshToken String?

  childRelations           FamilyRelation[]  @relation("ParentRelations")
  parentRelations          FamilyRelation[]  @relation("ChildRelations")
  childTransferRequests    TransferRequest[] @relation("ChildTransferRequests")
  resolvedTransferRequests TransferRequest[] @relation("ResolvedTransferRequests")
  createdTasks             Task[]            @relation("CreatedTasks")
  assignedTasks            Task[]            @relation("AssignedTasks")
  completedTasks           Task[]            @relation("CompletedTasks")
  piggyBanks               PiggyBank[]       @relation("OwnerPiggyBanks")
  piggyBankContributions   PiggyBankContribution[]
  notifications            Notification[]    @relation("UserNotifications")
  childNotifications       Notification[]    @relation("ChildNotifications")

  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  cards                    Card[]
  transactions             Transaction[]
}

model FamilyRelation {
  id        String   @id @default(uuid())
  parentId  String
  childId   String
  createdAt DateTime @default(now())

  parent    User     @relation("ParentRelations", fields: [parentId], references: [id], onDelete: Cascade)
  child     User     @relation("ChildRelations", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}
model Card {
  id                    String  @id @default(uuid())
  cardNumberMask        String // например: "4258 •••• •••• 1234"
  cardholderName        String // "ANDREW DREMIN"
  expiryDate            String // "10/28"
  type                  String // "VIRTUAL" или "PHYSICAL"
  balance               Decimal @default(0.0) @db.Decimal(10, 2)
  isBlocked             Boolean @default(false)

  dailyLimit            Decimal @default(15.0) @db.Decimal(10, 2)
  spentToday            Decimal @default(0.0) @db.Decimal(10, 2)

  allowOnlinePurchases  Boolean @default(true)
  allowCashWithdrawal   Boolean @default(false)

  userId           String
  user             User              @relation(fields: [userId], references: [id])
  transactions     Transaction[]
  transferRequests TransferRequest[]
  taskCreatorCards Task[]            @relation("TaskCreatorCard")
  taskTargetCards  Task[]            @relation("TaskTargetCard")
  piggyBankContributions PiggyBankContribution[]
}

model Transaction {
  id            String            @id @default(uuid())
  amount        Decimal           @db.Decimal(10, 2)
  merchant      String
  category      String
  status        TransactionStatus @default(SUCCESS)
  // declineReason String?

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  card      Card     @relation(fields: [cardId], references: [id])
  cardId    String
  createdAt DateTime @default(now())
}

model TransferRequest {
  id            String                @id @default(uuid())
  amount        Decimal               @db.Decimal(10, 2)
  comment       String
  status        TransferRequestStatus @default(PENDING)
  declineReason String?

  childId       String
  child         User                  @relation("ChildTransferRequests", fields: [childId], references: [id], onDelete: Cascade)

  cardId        String
  card          Card                  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  resolvedById  String?
  resolvedBy    User?                 @relation("ResolvedTransferRequests", fields: [resolvedById], references: [id])

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

enum TransferRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model Task {
  id                String       @id @default(uuid())
  title             String
  description       String?
  rewardAmount      Decimal      @db.Decimal(10, 2)
  deadline          DateTime?
  status            TaskStatus   @default(OPEN)

  creatorId         String
  creator           User         @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)

  creatorCardId     String?
  creatorCard       Card?        @relation("TaskCreatorCard", fields: [creatorCardId], references: [id], onDelete: SetNull)

  assignedChildId   String?
  assignedChild     User?        @relation("AssignedTasks", fields: [assignedChildId], references: [id], onDelete: SetNull)

  completedById     String?
  completedBy       User?        @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: SetNull)

  targetCardId      String?
  targetCard        Card?        @relation("TaskTargetCard", fields: [targetCardId], references: [id], onDelete: SetNull)

  submissionComment String?
  submittedAt       DateTime?
  rejectionReason   String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

model PiggyBank {
  id            String                  @id @default(uuid())
  title         String                  // Например: "PlayStation 5", "Новый велосипед"
  description   String?
  targetAmount  Decimal                 @db.Decimal(10, 2) // Целевая сумма
  currentAmount Decimal                 @default(0.0) @db.Decimal(10, 2) // Накоплено
  targetDate    DateTime?               // Желаемая дата достижения цели
  status        PiggyBankStatus         @default(ACTIVE)

  // Владелец копилки (только ребенок!)
  ownerId       String
  owner         User                    @relation("OwnerPiggyBanks", fields: [ownerId], references: [id], onDelete: Cascade)

  // История пополнений от ребенка и членов семьи
  contributions PiggyBankContribution[]

  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model PiggyBankContribution {
  id          String     @id @default(uuid())
  amount      Decimal    @db.Decimal(10, 2)
  comment     String?    // Пожелание / поздравление от члена семьи

  piggyBankId String
  piggyBank   PiggyBank  @relation(fields: [piggyBankId], references: [id], onDelete: Cascade)

  userId      String     // Кто пополнил (ребенок или родственник)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId      String?    // С какой карты списали
  card        Card?      @relation(fields: [cardId], references: [id], onDelete: SetNull)

  createdAt   DateTime   @default(now())
}

enum PiggyBankStatus {
  ACTIVE
  COMPLETED
  BROKEN
}

enum UserRole {
  ORDINARY
  PARENT
  CHILD_7_13
  TEEN_14_17
}

enum Category {
  FOOD // Столовая, кафе
  TRANSPORT // Проезд, такси
  EDUCATION // Книги, канцелярия, курсы
  ENTERTAINMENT // Игры, кино, подписки
  RESTRICTED_18 // Азартные игры, алкоголь, табак
  TRANSFER // Переводы между счетами / пополнение от родителей
  TASK_REWARD // Награда за выполнение заданий
  SAVINGS // Копилка и накопления
  OTHER
}

enum TransactionStatus {
  SUCCESS
  DECLINED_BY_BANK // Блокировка 18+, казино и т.д.
  DECLINED_BY_LIMIT // Превышен лимит
  PENDING_PARENT_APPROVAL // Ждет аппрува от родителя
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)

  // Получатель уведомления (родитель)
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // Ребенок, совершивший действие
  childId   String?
  child     User?            @relation("ChildNotifications", fields: [childId], references: [id], onDelete: SetNull)

  createdAt DateTime         @default(now())
}

enum NotificationType {
  RESTRICTED_18_PURCHASE // Попытка покупки товара 18+ (алкоголь, табак, казино)
  NIGHT_PURCHASE         // Покупка в ночное время (после 23:00)
  LIMIT_EXCEEDED         // Превышен суточный лимит
  TRANSFER_REQUEST       // Запрос на перевод денег
  TASK_SUBMITTED         // Задание сдано на проверку
  PIGGY_BANK_TOPUP       // Пополнение копилки
}


